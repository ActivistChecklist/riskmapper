{
  // The root config excludes copy.mts because the app does not install
  // mongodb. After `yarn install` in this folder, from the repo root:
  //   npx tsc -p scripts/mongo-to-sqlite
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "typeRoots": ["../../node_modules/@types"],
    "types": ["node"]
  },
  "include": ["*.mts"],
  "exclude": []
}
