# Risk Mapper — local development environment.

# Copy this file to `.env.local` and edit.

# ─── Client (VITE_*) ────────────────────────────────────────────────

# Optional. Set to "false" to hide all share-to-cloud affordances.
# Default: enabled.
# VITE_CLOUD_SYNC_ENABLED=true

# Optional. Absolute base URL for the cloud API. By default the client
# uses same-origin relative URLs (/api/matrix). Override only if you're
# pointing the SPA at a remote API during local development.
# VITE_CLOUD_API_URL=

# ─── Server variables ────────────────────────────────────────────────

VITE_DEBUG=false

# Optional. The SQLite database that holds shared matrices. Created on first
# use, with its directory 0700 and the file 0600. The default is relative to
# the working directory and gitignored. Set an absolute path in production.
# SQLITE_PATH=.data/riskmapper.sqlite

# Optional limits. Defaults shown. RETENTION_DAYS is read by the daily
# cleanup (`yarn sqlite:cleanup`); the Security page promises 90.
# MAX_CIPHERTEXT_BYTES=262144
# RETENTION_DAYS=90
# WRITE_RATE_LIMIT_PER_MIN=240

# How many entries at the right end of X-Forwarded-For your own proxies
# write. The visitor's address is the leftmost of those. 1 fits May First
# (and any host with one appending proxy). Unset locally.
# TRUSTED_PROXY_HOPS=1

# Server only, for `yarn sqlite:backup`. A shell command that takes the
# snapshot at $BACKUP_FILE (suggested name $BACKUP_NAME), encrypts it and
# sends it offsite. Its destination and keys live only in the server's
# environment. See scripts/sqlite-backup.mts.
# SQLITE_BACKUP_UPLOAD_CMD=

# ─── Analytics (Umami via privacy relay) ─────────────────────────────
# All optional — if these are unset, /api/counter returns an error and
# the client helper silently swallows it. The browser never talks to
# Umami directly; the relay anonymizes the client IP using `geo-hash`
# (preserves coarse country/region info, randomizes per-visitor bits).

# Required when analytics is enabled (both cloud and self-hosted).
# UMAMI_WEBSITE_ID=

# Salt for the daily-rotating IP hash. Required for `geo-hash` to work.
# Use a long, random, server-only secret.
# IP_HASH_SALT=

# ─── Umami Cloud (use these OR the self-hosted block below) ──────────
# UMAMI_API_KEY=

# ─── Self-hosted Umami (use these OR the cloud block above) ──────────
# UMAMI_API_CLIENT_USER_ID=
# UMAMI_API_CLIENT_SECRET=
# UMAMI_API_CLIENT_ENDPOINT=https://umami.example.com

# ─── WEBCAT monitoring ───────────────────────────────────────────────

# Optional. Dead-man's-switch monitor for `yarn webcat:verify`
# (healthchecks.io or compatible). On success the script POSTs to this URL;
# on failure it POSTs to <url>/fail with the list of drifted files, so the
# alert names them. Treat as a credential: anyone holding it can post a false
# success and silence the alarm. Also set as the WEBCAT_PING_URL secret on
# the GitHub repo, which is where the scheduled check runs.
# WEBCAT_PING_URL=https://hc-ping.com/<your-uuid>
